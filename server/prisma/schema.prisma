generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OWNER)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model Menu {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Float
  category    String
  image       String?
  available   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id           String      @id @default(uuid())
  customerName String
  tableNumber  Int
  totalAmount  Float
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  price     Float
  orderId   String
  menuId    String
  createdAt DateTime @default(now())
  menu      Menu     @relation(fields: [menuId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Inventory {
  id                String   @id @default(uuid())
  name              String
  category          String
  quantity          Float
  unit              String
  purchasePrice     Float
  supplier          String?
  warehouse         String?
  lowStockThreshold Float    @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  OWNER
  MANAGER
  CHEF
  WAITER
  CASHIER
  STORE_MANAGER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}
